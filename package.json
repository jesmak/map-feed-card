{
    "name": "map-feed-card",
    "version": "1.1.0",
    "description": "Home Assistant dashboard card that draws map feeds (trains, ships, buses, road works, birds…) on Home Assistant's own map, with the selected item's details beside it",
    "keywords": [
        "home-assistant",
        "homeassistant",
        "hass",
        "lovelace",
        "custom-cards",
        "map",
        "geojson",
        "maplibre"
    ],
    "type": "module",
    "private": true,
    "license": "MIT",
    "repository": "git@github.com:jesmak/map-feed-card.git",
    "engines": {
        "node": ">=22.13"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "typecheck": "tsc",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
    },
    "dependencies": {
        "@versatiles/style": "^6.4.1",
        "lit": "^3.3.3",
        "maplibre-gl": "^6.14.0"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^10.0.1",
        "@types/geojson": "^7946.0.16",
        "esbuild": "^0.28.2",
        "eslint": "^10.12.0",
        "happy-dom": "^21.0.1",
        "prettier": "^3.9.10",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.2",
        "vitest": "^5.0.5"
    }
}
